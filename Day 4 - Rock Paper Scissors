import random

rock = '''
    _______
---'   ____)
      (_____)
      (_____)
      (____)
---.__(___)
'''

paper = '''
    _______
---'   ____)____
          ______)
          _______)
         _______)
---.__________)
'''

scissors = '''
    _______
---'   ____)____
          ______)
       __________)
      (____)
---.__(___)
'''

rps_list = [rock, paper, scissors]
opponent_choice = random.choice(rps_list)

print('What do you choose? Type 0 for Rock, 1 for Paper or 2 for Scissors: ')
player_choice = int(input())
if player_choice > 2:
    print('Invalid selection')
    exit()
    
print(rps_list[player_choice])
print(opponent_choice)

if rps_list[player_choice] == opponent_choice:
    print('Draw!')
elif (player_choice == 0 and opponent_choice == scissors) or (player_choice == 1 and opponent_choice == rock) or (player_choice == 2 and opponent_choice == paper):
    print('You win!')
else:
    print('You lose!')

import random
word_list = ["aardvark", "baboon", "camel"]

chosen_word = random.choice(word_list)
print(chosen_word)

placeholder = ''
for inc in range(len(chosen_word)):
    placeholder += '_'
print(placeholder)

lives = 6

while lives > 0:

    guess = input('Guess a letter: ').lower()

    if guess in chosen_word:
        print('Right')

        display = '_'


        # TODO-2: Change the for loop so that you keep the previous correct letters in display.

        for inc in range(len(chosen_word)):
            if display[inc] == chosen_word[inc]:
                display += chosen_word[inc]
            elif chosen_word[inc] == guess:
                display += guess
            else:
                display += '_'
        print(display)
    else:
        print('Wrong')
        lives -= 1

    print(f'Lives: {lives}')


